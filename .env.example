# Redis connection URL (from Vercel Redis or any Redis provider)
# Format: redis://username:password@host:port
# Example: redis://default:password@redis-12345.upstash.io:6379
REDIS_URL=your_redis_url_here

# Vercel sends this secret as a Bearer token when invoking the daily cron.
# Set a random value of at least 32 characters in the Production environment.
CRON_SECRET=
